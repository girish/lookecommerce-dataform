config {
  type: "table",
  schema: "thelook_ecommerce_launch_demo",
  description: "Cleaned order item data from thelook_ecommerce",
  columns: {
    id: "The unique ID of the order item.",
    order_id: "The ID of the order this item belongs to.",
    user_id: "The ID of the user who placed the order.",
    product_id: "The ID of the product.",
    inventory_item_id: "The ID of the inventory item.",
    status: "The status of the order item.",
    created_at: "The timestamp when the order item was created.",
    shipped_at: "The timestamp when the order item was shipped.",
    delivered_at: "The timestamp when the order item was delivered.",
    returned_at: "The timestamp when the order item was returned.",
    sale_price: "The sale price of the order item."
  }
}

WITH cleaned_order_items AS (
  SELECT
    CAST(id AS STRING) AS id,
    CAST(order_id AS STRING) AS order_id,
    CAST(user_id AS STRING) AS user_id,
    CAST(product_id AS STRING) AS product_id,
    CAST(inventory_item_id AS STRING) AS inventory_item_id,
    COALESCE(status, 'Unknown') AS status,
    created_at,
    shipped_at,
    delivered_at,
    returned_at,
    sale_price
  FROM
    ${ref("order_items_source")}
)
SELECT
  *
FROM
  cleaned_order_items
QUALIFY ROW_NUMBER() OVER (PARTITION BY id ORDER BY created_at DESC) = 1
